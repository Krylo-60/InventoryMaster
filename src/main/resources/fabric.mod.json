{
  "schemaVersion": 1,
  "id": "inventorymaster",
  "version": "${version}",
  "name": "InventoryMaster — Ultimate Inventory QoL",
  "description": "Comprehensive 1-click inventory & chest sorting, quick stacking, auto-refill, shulker tooltip previews, and durability alerts.",
  "authors": [
    "Krylo_plays"
  ],
  "contact": {
    "homepage": "https://krishivstudios.github.io",
    "sources": "https://github.com/KrishivStudios/InventoryMaster",
    "issues": "https://github.com/KrishivStudios/InventoryMaster/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/inventorymaster/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.krishivstudios.inventorymaster.InventoryMaster"
    ],
    "client": [
      "com.krishivstudios.inventorymaster.client.InventoryMasterClient"
    ]
  },
  "mixins": [
    "inventorymaster.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.21",
    "java": ">=21"
  }
}
